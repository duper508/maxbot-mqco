# Example environment file for API Health Check
# Copy this to ~/.api_health_check.env and fill in your actual API keys
# DO NOT commit your real keys to Git!

export VERCEL_API_KEY="your-vercel-ai-gateway-key"
export GROQ_API_KEY="your-groq-api-key"
export BRAVE_API_KEY="your-brave-search-key"
export ELEVENLABS_API_KEY="your-elevenlabs-api-key"
export GOOGLE_API_KEY="your-google-api-key"
